LLM_PROVIDER=genai

# genai (AI Studio) settings — used only if LLM_PROVIDER=genai
GOOGLE_API_KEY=your_gemini_api_key_here

# vertexai settings — used only if LLM_PROVIDER=vertexai
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your-service-account.json
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1

GENERATION_MODEL=gemini-flash-latest
EMBEDDING_MODEL=models/gemini-embedding-001

CHROMA_PERSIST_DIR=.chroma
COLLECTION_NAME=rag_docs

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Tuned against a deterministic retrieval benchmark, not by feel — see
# ENGINEERING.md's Retrieval tuning section. RERANK_TOP_K=3 looks better on
# precision but drops real content; don't lower it without re-measuring.
RETRIEVER_TOP_K=10
RERANK_TOP_K=5

# Web search (Tavily) — set the key to enable; unset or WEB_SEARCH_ENABLED=false to disable
TAVILY_API_KEY=your_tavily_api_key_here
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# Text-to-SQL — built by `python cli.py build-sql-db`, queried by `python cli.py sql`
SQL_DB_PATH=data/structured.db
SQL_QUERY_ROW_LIMIT=200

# Query decomposition (max sub-questions a compound question splits into)
MAX_SUBQUESTIONS=4

# Corrective RAG (min graded-relevant local docs before skipping the web fallback)
CRAG_MIN_RELEVANT_DOCS=1

# Parent-document retrieval (separate collection + persisted docstore for parent chunks)
PARENT_DOCSTORE_DIR=.parent_docstore
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=40
PARENT_RETRIEVER_TOP_K=4

# Source catalog (one LLM-generated sentence per ingested source, cached to disk)
SOURCE_CATALOG_PATH=.source_catalog.json

# Self-correcting generation (Self-RAG/RRR): bounded retries for the
# hallucination-regenerate loop and the answers-question-rewrite loop
MAX_HALLUCINATION_RETRIES=1
MAX_QUESTION_REWRITES=1

# How many sub-questions retrieve concurrently. Kept modest: each sub-question
# fires several LLM calls, and Vertex AI returns 429 under heavy parallelism.
RETRIEVAL_MAX_CONCURRENCY=4
